# --- Obligatorias ---

# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=123456789:AAAA-reemplazar
# chat_id de la persona que usa el bot (los demás chats se ignoran)
TELEGRAM_CHAT_ID=123456789
# API key de Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-reemplazar
# API key de USDA FoodData Central (gratis)
USDA_API_KEY=reemplazar
# Clave que inventás vos para consumir la API REST (header x-api-key)
API_KEY=una-clave-larga-y-dificil

# --- Opcionales (estos son los valores por defecto) ---

CLAUDE_MODEL=claude-sonnet-5-5
PORT=3000
# Mililitros que suma el botón "+1 vaso"
VASO_ML=250
# Peso meta en kg. Si lo dejás vacío, el bot no muestra el avance hacia la meta.
PESO_OBJETIVO=

# Horarios de recordatorios en hora argentina (HH:MM). Se pueden poner varios separados por coma.
RECORDATORIO_DESAYUNO=08:30
RECORDATORIO_ALMUERZO=13:00
RECORDATORIO_MERIENDA=17:30
RECORDATORIO_CENA=21:00
RECORDATORIO_AGUA=10:00,12:00,15:00,17:00,19:00
RECORDATORIO_PESO=08:00
